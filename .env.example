# 複製此檔案為 .env 並填入實際值
# cp .env.example .env

# PostgreSQL
POSTGRES_PASSWORD=postgres

# Google Gemini（答案生成）
GOOGLE_API_KEY=your_google_api_key_here

# Chunk 壓縮用 Gemini key，若不填則自動 fallback 使用 GOOGLE_API_KEY
# COMPRESS_KEY=your_google_api_key_here

# SerpAPI（教授搜尋功能）
SERPAPI_KEY=your_serpapi_key_here

# Groq（選校推薦意圖分析）
GROQ_API_KEY=your_groq_api_key_here
