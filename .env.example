# 複製此檔案為 backend/.env 並填入實際值
# cp .env.example backend/.env

# ── 資料庫 ──
# Docker 模式：compose 會用 POSTGRES_PASSWORD 起 db 容器，backend 容器內的
#              DATABASE_URL 由 compose 自動注入（連 db:5432），不需在此設定。
POSTGRES_PASSWORD=postgres
# 本機模式（不透過 docker 跑 backend）：需自行設定 DATABASE_URL 連到 db 容器對外的埠。
# 注意：docker-compose 將 db 對外映射到 5433（不是 5432）；連 docker 的 db 請用 5433，
#       只有自行安裝的原生 PostgreSQL 才是 5432。
# Windows + Docker Desktop 建議用 127.0.0.1 而非 localhost（避免 IPv6 解析延遲）。
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/studyabroad

# ── OpenAI ──
OPENAI_API_KEY=
# 分級模型：判斷/結構型任務（decomposer / verifier / critic / text-to-SQL）用便宜快的模型，
#           最終答案生成用強一點的模型，各自可覆寫。
OPENAI_MODEL=gpt-4.1
OPENAI_ANSWER_MODEL=gpt-4o

# ── SerpAPI（教授搜尋功能）──
SERPAPI_KEY=your_serpapi_key_here

# ── 向量檢索（選配）──
# hybrid search fallback 用的模型路徑；未設定時直接用 HuggingFace model id 線上下載。
# 模型未下載 / sentence-transformers 缺失時自動降級純 FTS，不影響既有功能。
# 向量生效前需先跑：python -m data_crawler.backfill_embeddings
BGE_EMBED_MODEL_PATH=
BGE_RERANKER_MODEL_PATH=
